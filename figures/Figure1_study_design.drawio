<mxfile host="drawio"><diagram id="study-design" name="Figure 1"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="879" pageHeight="796" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q" value="&lt;b&gt;Question: when a price moves little after news, does that show that the news had no effect?&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10.0" y="10.0" width="859.0" height="48.0" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Conclusions and scope&lt;/b&gt; (Sections 4 and 5)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10.0" y="742.0" width="859.0" height="44.0" as="geometry"/></mxCell><mxCell id="theory" value="&lt;b&gt;Theory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Sections 2.1–2.2 · RQ1&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:13px&quot;&gt;constructive argument&lt;/span&gt;&lt;/i&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=66;rounded=1;arcSize=3;fillColor=#E4E4E4;swimlaneFillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=15;fontStyle=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="10.0" y="86.0" width="205.0" height="622.0" as="geometry"/></mxCell><mxCell id="t1" value="Net versus component absence (Equations (2) and (3))" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#666666;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="theory"><mxGeometry x="12.0" y="78.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="t2" value="Two worlds with identical observables (Figure 3)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#666666;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="theory"><mxGeometry x="12.0" y="156.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="t3" value="Partial-identification bounds: observable and oracle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=#666666;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="theory"><mxGeometry x="12.0" y="312.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="sim" value="&lt;b&gt;Known-truth simulation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Section 2.5 · RQ1–RQ2&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:13px&quot;&gt;known truth&lt;/span&gt;&lt;/i&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=66;rounded=1;arcSize=3;fillColor=#D5E5F5;swimlaneFillColor=#FFFFFF;strokeColor=#2F6DB0;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=15;fontStyle=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="228.0" y="86.0" width="205.0" height="622.0" as="geometry"/></mxCell><mxCell id="s1" value="10 scenarios × 100 replications; 6 learners" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="sim"><mxGeometry x="12.0" y="78.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="s2" value="Absence diagnostics against population prevalence (Figure 4, Table S5)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="sim"><mxGeometry x="12.0" y="156.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="s3" value="Latent-MSE comparisons with positive controls (Table 1)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="sim"><mxGeometry x="12.0" y="234.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="s4" value="Repairs: volume λ, text rule q, nonlinear learners; bounds evaluated (Table 2)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="sim"><mxGeometry x="12.0" y="312.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="thai" value="&lt;b&gt;Thai bank pilot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Sections 2.4, 2.6–2.8 · RQ3–RQ7&lt;/span&gt;&lt;br&gt;&lt;i&gt;&lt;span style=&quot;font-size:13px&quot;&gt;retrospective, exploratory&lt;/span&gt;&lt;/i&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=66;rounded=1;arcSize=3;fillColor=#FAD9C2;swimlaneFillColor=#FFFFFF;strokeColor=#C0561A;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=15;fontStyle=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="446.0" y="86.0" width="205.0" height="622.0" as="geometry"/></mxCell><mxCell id="p1" value="Data audit and provenance gates: 8 banks, 11,440 news records (Tables S6 and S13)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="thai"><mxGeometry x="12.0" y="78.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="p2" value="RDFL labels from price response and trading volume (Figure 2)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="thai"><mxGeometry x="12.0" y="156.0" width="181.0" height="62.0" as="geometry"/></mxCell><mxCell id="p3" value="7 quarterly folds, 5-session purge, exact-overlap exclusion (Figure S1)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="thai"><mxGeom