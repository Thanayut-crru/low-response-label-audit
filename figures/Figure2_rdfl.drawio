<mxfile host="drawio"><diagram id="rdfl" name="Figure 2"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="960" pageHeight="424" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Per stock and in date order; every statistic for session &lt;i&gt;t&lt;/i&gt; uses sessions up to &lt;i&gt;t&lt;/i&gt; only" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="10.0" y="4.0" width="940.0" height="24.0" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1. Target&lt;/b&gt;&lt;br&gt;&lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = log(Close&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; / Open&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="10.0" y="34.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2. Price-only forecast&lt;/b&gt;&lt;br&gt;ridge on 10 lagged price features&lt;br&gt;residual &lt;i&gt;r&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;y&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; − &lt;i&gt;ŷ&lt;/i&gt;&lt;sup&gt;p&lt;/sup&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="250.0" y="34.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3. Robust standardization&lt;/b&gt;&lt;br&gt;&lt;i&gt;z&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = (&lt;i&gt;r&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; − med) / (1.4826 MAD)&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = |robust &lt;i&gt;z&lt;/i&gt; of log(1 + Volume&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;)|&lt;br&gt;over the last 60 sessions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="490.0" y="34.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4. Thresholds from the past&lt;/b&gt;&lt;br&gt;&lt;i&gt;q&lt;/i&gt;&lt;sub&gt;L&lt;/sub&gt;, &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;H&lt;/sub&gt;: 30th, 70th pct. of |&lt;i&gt;z&lt;/i&gt;|&lt;br&gt;&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;L&lt;/sub&gt;, &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;H&lt;/sub&gt;: 50th, 90th pct. of &lt;i&gt;v&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="730.0" y="34.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5. Fuzzy sets&lt;/b&gt;&lt;br&gt;response low ℓ: 1→0 on [&lt;i&gt;q&lt;/i&gt;&lt;sub&gt;L&lt;/sub&gt;, &lt;i&gt;q&lt;/i&gt;&lt;sub&gt;H&lt;/sub&gt;]&lt;br&gt;response high &lt;i&gt;h&lt;/i&gt; = 1 − ℓ&lt;br&gt;volume normal &lt;i&gt;n&lt;/i&gt;: 1→0 on [&lt;i&gt;v&lt;/i&gt;&lt;sub&gt;L&lt;/sub&gt;, &lt;i&gt;v&lt;/i&gt;&lt;sub&gt;H&lt;/sub&gt;]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="730.0" y="172.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6. Fuzzy rules&lt;/b&gt; (AND = min)&lt;br&gt;IF response high AND &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; &amp;lt; 0 THEN negative:&amp;nbsp; &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;neg&lt;/sub&gt; = &lt;i&gt;h&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#9B2C1F&quot;&gt;IF response low AND volume normal THEN low response:&amp;nbsp; &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;low&lt;/sub&gt; = min(ℓ, &lt;i&gt;n&lt;/i&gt;)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;IF response high AND &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; &amp;gt; 0 THEN positive:&amp;nbsp; &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;pos&lt;/sub&gt; = &lt;i&gt;h&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="250.0" y="172.0" width="460.0" height="104.0" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7. Soft label, retention&lt;/b&gt;&lt;br&gt;&lt;i&gt;p&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; / Σ &lt;i&gt;m&lt;/i&gt;,&amp;nbsp; &lt;i&gt;c&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; = max&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;m&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;keep if &lt;i&gt;c&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt; ≥ 0.70, news present,&lt;br&gt;outcome valid" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E8;strokeColor=#C0561A;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="10.0" y="172.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="news" value="&lt;b&gt;News text&lt;/b&gt;&lt;br&gt;stock-day text bag&lt;br&gt;character TF-IDF, refitted per fold" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="10.0" y="310.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8. Soft-label learner&lt;/b&gt; (RDFL_SOFT)&lt;br&gt;classifier trained on retained bags, weights &lt;i&gt;p&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;·&lt;i&gt;c&lt;/i&gt;&lt;sub&gt;&lt;i&gt;t&lt;/i&gt;&lt;/sub&gt;&lt;br&gt;class centers &lt;i&gt;μ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; = weighted mean training target" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="250.0" y="310.0" width="460.0" height="104.0" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;9. Forecast&lt;/b&gt;&lt;br&gt;&lt;i&gt;ŷ&lt;/i&gt; = Σ&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;p̂&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;μ&lt;/i&gt;&lt;sub&gt;&lt;i&gt;k&lt;/i&gt;&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#2F6DB0;fontFamily=Times New Roman;fontSize=14;spacing=4;" vertex="1" parent="1"><mxGeometry x="730.0" y="310.0" width="220.0" height="104.0" as="geometry"/></mxCell><mxCell id="b1-b2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b2-b3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b3-b4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b4-b5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b5-b6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b6-b7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b7-b8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="news-b8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="news" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b8-b9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>